rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return isSignedIn() && resource.data.createdBy == request.auth.uid;
    }

    function isCreatingOwnDoc() {
      return isSignedIn() && request.resource.data.createdBy == request.auth.uid;
    }

    match /recipes/{recipeId} {
      allow read: if true;
      allow create: if isCreatingOwnDoc();
      allow update, delete: if isOwner();
    }

    match /community_posts/{postId} {
      allow read: if true;
      allow create: if isCreatingOwnDoc();
      allow update, delete: if isOwner();
    }

    match /users/{userId} {
      allow read, update, delete: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
    }

    match /saved_recipes/{savedId} {
      allow read, update, delete: if isOwner();
      allow create: if isCreatingOwnDoc();
    }

    match /grocery_items/{itemId} {
      allow read, update, delete: if isOwner();
      allow create: if isCreatingOwnDoc();
    }

    match /assistant_messages/{messageId} {
      allow read, update, delete: if isOwner();
      allow create: if isCreatingOwnDoc();
    }
  }
}
