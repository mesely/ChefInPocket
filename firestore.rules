rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: only the owner can read/write their own profile
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Recipes: anyone authenticated can read; only creator can write/delete
    match /recipes/{recipeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.keys().hasAll(['id','title','createdBy','createdAt']);
      allow update, delete: if request.auth != null
        && resource.data.createdBy == request.auth.uid;
    }

    // Saved recipes: per-user subcollection, only owner can read/write
    match /savedRecipes/{uid}/items/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Grocery items: per-user subcollection, only owner can read/write
    match /groceryItems/{uid}/items/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
